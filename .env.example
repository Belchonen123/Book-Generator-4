# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Auth (Convex Auth)
# Set on Convex deployment via `npx convex env set`:
#   JWT_PRIVATE_KEY, JWKS, SITE_URL, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
# See: https://labs.convex.dev/auth/setup
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_PRO=

# Rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
